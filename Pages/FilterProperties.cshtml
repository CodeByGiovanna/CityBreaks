@page
@model FilterPropertiesModel
@{
    ViewData["Title"] = "Filtrar propriedades";
}

<h1>Filtrar propriedades</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-2">
        <label asp-for="MinPrice" class="form-label">Preço mínimo</label>
        <input asp-for="MinPrice" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="MaxPrice" class="form-label">Preço máximo</label>
        <input asp-for="MaxPrice" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="CityName" class="form-label">Cidade</label>
        <input asp-for="CityName" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="PropertyName" class="form-label">Nome da propriedade</label>
        <input asp-for="PropertyName" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-page="/FilterProperties" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>

<h2 class="h5">Filtros aplicados</h2>
@if (Model.AppliedFilters.Any())
{
    <ul>
        @foreach (var filter in Model.AppliedFilters)
        {
            <li>@filter</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Nenhum filtro aplicado. Mostrando todas as propriedades ativas.</p>
}

<h2 class="h5">Resultados (@Model.Results.Count)</h2>
@if (Model.Results.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Propriedade</th>
                <th>Cidade</th>
                <th>País</th>
                <th>Preço por noite</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var property in Model.Results)
            {
                <tr>
                    <td>@property.Name</td>
                    <td>@property.City.Name</td>
                    <td>@property.City.Country.CountryName</td>
                    <td>€ @property.PricePerNight.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Nenhuma propriedade encontrada com esses filtros.</p>
}